# Ultimate Deejays — environment variables
#
# Copy this file to .env.local and fill in the values:   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# only put publishable keys there. Everything else stays on the server.
# Variables are validated on first use by lib/env.ts.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin, used for absolute URLs (metadata, sitemap, auth redirects,
# Paystack callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database, auth, storage) ───────────────────────────────────────
# Dashboard → Project Settings → API Keys.
# Running locally instead? `npm run db:start` prints the local URL and keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…), or the legacy "anon" key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), or the legacy "service_role" key. BYPASSES Row Level Security.
# Server only: used by lib/supabase/admin.ts for webhooks and admin jobs.
SUPABASE_SECRET_KEY=

# ── Paystack (payments) ──────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use the pk_test_/sk_test_ keys until launch.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_
# Also used to verify webhook signatures. Set the webhook URL in Paystack to
#   <NEXT_PUBLIC_SITE_URL>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_

# ── Google sign-in (local Supabase only) ─────────────────────────────────────
# For a hosted project, add these in Supabase → Authentication → Providers → Google
# instead. For `supabase start`, put them in supabase/.env and enable
# [auth.external.google] in supabase/config.toml.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Text messages (Africa's Talking) ─────────────────────────────────────────
# Optional. Texts members when an edit they asked for is ready, or when the team
# has a question. Without these, nothing is sent and members still see every
# update in Account → My edits.
# Sign up at https://africastalking.com → your app → Settings → API Key.
# Use the username "sandbox" (and the sandbox API key) to test without sending real texts.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# A registered sender ID (e.g. ULTIMATEDJ) or short code. Leave empty to use the default.
AFRICASTALKING_SENDER_ID=

# ── File storage: Cloudflare R2 ──────────────────────────────────────────────
# Optional. Once these four are set, Studio → Store shows "Cloudflare R2" in the
# "Store uploads in" list (up to 5 GB per file, no download fees). Without them,
# store files go to Supabase Storage. Restart the site after changing them.
#
# Set up (Cloudflare dashboard → R2 Object Storage):
#   1. Create bucket, e.g. ultimate-deejays-store. Keep public access OFF.
#   2. The bucket → Settings → CORS policy → Add, and paste (put your real domain in too):
#        [{ "AllowedOrigins": ["http://localhost:3000", "https://your-domain.com"],
#           "AllowedMethods": ["PUT", "GET"], "AllowedHeaders": ["Content-Type"], "MaxAgeSeconds": 3600 }]
#   3. R2 overview → Manage API tokens → Create API token: "Object Read & Write",
#      applied to that bucket only. Copy the Access Key ID and Secret Access Key
#      (the secret is shown once).
# Your Account ID is on the R2 overview page (also in the S3 endpoint:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
